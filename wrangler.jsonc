{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tirbo-fish",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "tirbo.fish/*", "zone_name": "tirbo.fish" },
    { "pattern": "www.tirbo.fish/*", "zone_name": "tirbo.fish" }
  ]
}
