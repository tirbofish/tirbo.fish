{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tirbo-blogs",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "blogs.tirbo.fish", "custom_domain": true }
  ]
}
