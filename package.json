{
  "name": "tirbo.fish",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:blogs": "npm run dev --prefix blogs",
    "build": "tsc -b && vite build",
    "build:blogs": "npm run build --prefix blogs",
